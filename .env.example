# Copie este arquivo para .env.local e preencha. NUNCA suba .env.local para o GitHub
# (ele já está no .gitignore). No Vercel, cadastre estas variáveis em Settings → Environment Variables.

# Obrigatória: banco Postgres (Neon). Formato: postgresql://usuario:senha@host/banco?sslmode=require
DATABASE_URL=

# Endereço público do site, usado nos links de recuperação de senha. Ex.: https://curriculo-alvo.vercel.app
APP_URL=http://localhost:3000

# E-mail de recuperação de senha (https://resend.com). Sem a chave, em desenvolvimento o link aparece no terminal.
RESEND_API_KEY=
EMAIL_FROM=Currículo Alvo <onboarding@resend.dev>

# Opcional: vagas do Brasil pela Adzuna (https://developer.adzuna.com). Sem elas, usa Remotive + Arbeitnow.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
